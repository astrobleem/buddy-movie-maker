* text=auto
*.ps1 text eol=crlf
tools/BuddyMovieMaker/Runtime/*.C text eol=crlf
tools/BuddyMovieMaker/Runtime/*.H text eol=crlf
tools/BuddyMovieMaker/Runtime/*.ASM text eol=crlf
tools/BuddyMovieMaker/Runtime/*.BAT text eol=crlf
# Authoritative fixtures and third-party notices retain their original bytes.
tools/BuddyMovieMaker/Tests/Mml2Contract/* -text
# Frozen CRLF and malformed-source blank lines are part of the hashed corpus.
tools/BuddyMovieMaker/Tests/Mml3Contract/** -text whitespace=cr-at-eol,-blank-at-eof
notices/* -text
tools/BuddyMovieMaker/MML3.md -text
tools/BuddyMovieMaker/RuntimeMml3/*.C text eol=crlf
tools/BuddyMovieMaker/RuntimeMml3/*.H text eol=crlf
tools/BuddyMovieMaker/RuntimeMml3/*.ASM text eol=crlf
tools/BuddyMovieMaker/RuntimeMml3/*.BAT text eol=crlf
# Sound adapter handoff files retain their reviewed bytes.
tools/BuddyMovieMaker/RuntimeMml3/DOSSND.C -text whitespace=cr-at-eol
tools/BuddyMovieMaker/RuntimeMml3/DOSSND.H -text whitespace=cr-at-eol
tools/BuddyMovieMaker/RuntimeMml3/DOSGUARD.H -text whitespace=cr-at-eol
tools/BuddyMovieMaker/RuntimeMml3/win30/DRIVER/PITCORE.H -text whitespace=cr-at-eol
