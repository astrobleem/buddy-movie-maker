# Preserve the frozen corpus, including CRLF and malformed-source blank lines.
Tests/Mml3Contract/** -text whitespace=cr-at-eol,-blank-at-eof
MML3.md -text
RuntimeMml3/*.C text eol=crlf
RuntimeMml3/*.H text eol=crlf
RuntimeMml3/*.ASM text eol=crlf
RuntimeMml3/*.BAT text eol=crlf
# Sound adapter handoff files retain their reviewed bytes.
RuntimeMml3/DOSSND.C -text whitespace=cr-at-eol
RuntimeMml3/DOSSND.H -text whitespace=cr-at-eol
RuntimeMml3/DOSGUARD.H -text whitespace=cr-at-eol
RuntimeMml3/win30/DRIVER/PITCORE.H -text whitespace=cr-at-eol
